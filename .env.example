NEXT_PUBLIC_SITE_URL=https://www.sydrahealth.com

# Optional embed URL for the CMS May 2026 fee + batching explainer video.
# When unset, pages still show the inline transcript (no fake placeholder).
# NEXT_PUBLIC_CMS_RULE_BATCHING_VIDEO_URL=https://www.youtube.com/embed/VIDEO_ID
# Public and transactional mail is hardcoded to sales@sydrahealth.com. Do not set
# a second inbox. NEXT_PUBLIC_*_EMAIL and LEADS_*_EMAIL env vars are ignored.
# Optional display phone, e.g. (555) 123 4567
# NEXT_PUBLIC_CONTACT_PHONE=
# Optional comma separated social profile URLs for Organization sameAs schema
# Defaults to https://www.linkedin.com/company/sydra-health/ when unset.
# NEXT_PUBLIC_ORG_SAME_AS=https://www.linkedin.com/company/sydra-health/

# Google Ads account ID AW-18244375722 loads on every page via GoogleAdsTag.
# Primary conversion is hardcoded in src/lib/analytics/google-ads.ts:
#   Submit lead form: AW-18244375722/MhI6CKKQz8scEKqpzPtD
# Fires on /demo/thank-you, /recover/thank-you, and /case-review/thank-you after a
# full lead submit (not after email-only step 1).
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL is no longer required.

# Google Analytics 4 measurement ID (client). Defaults to the live Sydra Web
# stream (G-7KPTH8W6N3) in code, so this only needs setting to override it.
# Demo/lead form submits fire a `generate_lead` event you can mark as a key
# event in GA4. Find the ID in GA4 Admin > Data streams (starts with G-).
# NEXT_PUBLIC_GA4_ID=G-7KPTH8W6N3

# Google Search Console HTML-tag verification token (client). Only needed if you
# verify by meta tag instead of the DNS TXT record. Paste just the content value
# from the google-site-verification meta tag GSC gives you.
# NEXT_PUBLIC_GSC_VERIFICATION=

# Phased indexing wave. Raising this flips eligible programmatic pages from
# noindex to index with no content redeploy (tiers: state=2, cpt/cptState=3,
# cptStatePayer=4). When unset, defaults to 3 in code (state + CPT pages
# indexable; the deepest payer tier stays noindex). Override per environment.
# SEO_CURRENT_WAVE=3

# Comma separated UPPERCASE 2-letter state codes controlling which CPT-by-state
# child sitemaps are released (e.g. TX,CA,NY,NJ,FL,AZ). When unset, defaults to
# the launch states.
# SEO_CPT_WAVE_STATES=TX,CA,NY,NJ,FL,AZ

# Form lead delivery (server only — set in Vercel, not client)
# Required for /api/postcard-lead, /api/demo, /api/contact, and /api/claim-review.
# From, To, and Reply-To are always sales@sydrahealth.com.
# Every outbound email is BCC'd to georgestoff@rocketcreative.net.
# Confirm RESEND_API_KEY on Vercel Production before running ads.
# Paid traffic final URL should point at /recover (single CTA), not /.
# Step 1 of any lead form triggers the immediate "Thank you for your interest in
# Sydra" reply. Completing step 2 adds the founder demo confirmation.
# Demo submitters receive a founder confirmation at their work email.
# Claim-review submitters receive a founder auto-reply inviting a reply with one
# denied EOB attached. If RESEND_API_KEY is unset, that auto-reply does NOT send
# and deliverLead() logs that failure.
RESEND_API_KEY=

# Protected admin view at /admin/leads (HTTP Basic auth).
# Username is always "leads". Password is this value.
# LEADS_ADMIN_PASSWORD=

# Optional extra fallback channel (Slack incoming webhook). Supabase is primary.
# LEADS_FALLBACK_WEBHOOK_URL=

# Postcard landing (server only)
# CRM_WEBHOOK_URL=
# ANALYTICS_WEBHOOK_URL=

# Postcard landing (client)

# Entity-SEO data layer (Supabase). When unset, /idr pages render from the
# in-repo seed dataset (all noindex). Set these once the schema is migrated and
# seeded to read benchmark data from Postgres.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# Service role is server only — never expose to the client. Used for lead
# fallback writes, the /admin/leads view, and the seed script.
# SUPABASE_SERVICE_ROLE_KEY=
